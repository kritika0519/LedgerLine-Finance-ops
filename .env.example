# AI investigation provider. Use deterministic for local/offline operation.
AI_INVESTIGATION_PROVIDER=deterministic

# Required only when AI_INVESTIGATION_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=15

# Or use Google's Gemini provider. The key is server-side only.
# AI_INVESTIGATION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=15